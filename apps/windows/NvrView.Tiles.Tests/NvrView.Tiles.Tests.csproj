<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests of NvrView.Tiles on simulated time (a manual clock; nothing
       sleeps or reads the system clock). Run it with dotnet run. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>NvrView.Tiles.Tests</RootNamespace>
    <SelfContained>false</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../NvrView.Tiles/NvrView.Tiles.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Vectors shared with the Mac app's tests, beside the test binary. -->
    <None Include="../../../fixtures/synthetic/tile-header.json" Link="tile-header.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../../fixtures/synthetic/tile-views.json" Link="tile-views.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
