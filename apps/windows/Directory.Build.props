<Project>
  <!-- Shared by every project under apps/windows. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- The trim analyzer runs on every build of what the app ships, not only on the trimmed
         publish: code that reflects on something trimming may remove fails the ordinary build
         (warnings are errors), so the trimmed release build needs only a short run
         (SelfTest.Smoke.cs). The tests, the smoke test, and the demo are not shipped. -->
    <EnableTrimAnalyzer Condition="'$(MSBuildProjectName)' == 'NvrView.App' Or '$(MSBuildProjectName)' == 'NvrView.Interop' Or '$(MSBuildProjectName)' == 'NvrView.Video' Or '$(MSBuildProjectName)' == 'NvrView.Tiles' Or '$(MSBuildProjectName)' == 'NvrView.Shell'">true</EnableTrimAnalyzer>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Deterministic>true</Deterministic>
    <!-- Keep the build machine's paths out of the binaries. -->
    <PathMap>$(MSBuildThisFileDirectory)=apps/windows/</PathMap>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- One version for every app (and the macOS bundle): the VERSION file at the repository root. -->
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../../VERSION').Trim())</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
