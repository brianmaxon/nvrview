<Project>
  <!-- Shared by every project under apps/windows. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- The trim analyzer runs on every build, not only on the trimmed publish: code that
         reflects on something trimming may remove fails the ordinary build (warnings are errors),
         so the trimmed release build needs only a short run (SelfTest.Smoke.cs). -->
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Deterministic>true</Deterministic>
    <!-- Keep the build machine's paths out of the binaries. -->
    <PathMap>$(MSBuildThisFileDirectory)=apps/windows/</PathMap>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- One version for every app (and the macOS bundle): the VERSION file at the repository root. -->
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../../VERSION').Trim())</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
