<Project>
  <!-- Shared by every project under apps/windows. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- The trim analyzer runs on every build of what the app ships, not only on the trimmed
         publish: code that reflects on something trimming may remove fails the ordinary build
         (warnings are errors), so the trimmed release build needs only a short run
         (SelfTest.Smoke.cs). The tests, the smoke test, and the demo are not shipped. -->
    <EnableTrimAnalyzer Condition="'$(MSBuildProjectName)' == 'NvrView.App' Or '$(MSBuildProjectName)' == 'NvrView.Interop' Or '$(MSBuildProjectName)' == 'NvrView.Video' Or '$(MSBuildProjectName)' == 'NvrView.Tiles' Or '$(MSBuildProjectName)' == 'NvrView.Shell'">true</EnableTrimAnalyzer>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Deterministic>true</Deterministic>
    <!-- Keep the build machine's paths out of the binaries. -->
    <PathMap>$(MSBuildThisFileDirectory)=apps/windows/</PathMap>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- The version is not compiled in: a version bump must not change the build, so nothing is rebuilt or
         retested for it. The app reads it from version.txt next to the executable (AppVersion.Installed),
         which scripts/windows-app.sh writes from the VERSION file at the repository root. -->
    <Version>0.0.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
