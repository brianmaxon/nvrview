<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Windows viewer: a WinUI 3 window whose tile grid is drawn by
       NvrView.Video into a swap chain (see apps/windows/README.md).
       Unpackaged and self-contained: the Windows App SDK and the .NET
       runtime are copied next to the executable, nothing is installed. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <OutputType>WinExe</OutputType>
    <RootNamespace>NvrView.App</RootNamespace>
    <!-- Not "NvrView": NvrView.dll would collide with the core's nvrview.dll
         next to it (file names are case-insensitive). -->
    <AssemblyName>NvrView.App</AssemblyName>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Program.cs has its own Main (it parses the command line first). -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <!-- The app runs with invariant globalization; System.Speech names its recognizers by
         culture (en-US), which .NET refuses to create unless predefined cultures only is off. -->
    <PredefinedCulturesOnly>false</PredefinedCulturesOnly>
  </PropertyGroup>
  <!-- The release package is `dotnet publish` output (scripts/windows-app.sh publish).
       Partial trimming: only the assemblies that opt in (the .NET libraries, the Windows
       SDK projection, WinRT.Runtime, TerraFX) are trimmed; the app's own assemblies are
       kept whole, so nothing it reflects over can disappear. The only trim warnings are
       one summary (IL2104) each for three packages we do not own: the Windows SDK
       projection and WinRT.Runtime (C#/WinRT's reflection fallbacks for generic
       collections, unused here) and System.Speech (grammar-from-assembly loading,
       unused: the app only uses the built-in dictation grammar). They stay warnings, not errors,
       and nothing else is exempt. The self-test and the plain start run against this
       publish output (scripts/windows-worker.sh). -->
  <PropertyGroup>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <DebuggerSupport>false</DebuggerSupport>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);IL2104</WarningsNotAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../NvrView.Interop/NvrView.Interop.csproj" />
    <ProjectReference Include="../NvrView.Video/NvrView.Video.csproj" />
    <ProjectReference Include="../NvrView.Tiles/NvrView.Tiles.csproj" />
    <ProjectReference Include="../NvrView.Shell/NvrView.Shell.csproj" />
    <!-- Microsoft Software License Terms (redistributable; see
         apps/windows/README.md, "Windows App SDK"). The components the app
         uses, at the versions the 1.8.260921001 metapackage pins, instead of
         the metapackage itself: it also pulls in Windows ML (onnxruntime.dll
         and DirectML.dll, about 40 MB) and the AI, Widgets, and DWrite
         components, none of which the app uses. WinUI brings Foundation,
         Base, and InteractiveExperiences with it; they are listed so the
         pins are visible. Windows ML returns with the first feature that
         runs a model. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.Base" Version="1.8.251216001" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="1.8.260803002" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="1.8.260708001" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="1.8.260803003" />
    <!-- MIT; the desktop speech recognizer of Windows for the call's live captions
         (apps/windows/README.md, "Calls"). -->
    <PackageReference Include="System.Speech" Version="10.0.0" />
  </ItemGroup>
  <!-- No debugger or crash-dump support files in the package (about 6 MB): the runtime
       does not need them to run, only a debugger attached to the process does. -->
  <Target Name="DropDebuggerFilesFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_DebuggerFile Include="@(ResolvedFileToPublish)"
                     Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(Filename)%(Extension)', '^(mscordaccore.*\.dll|mscordbi\.dll|createdump\.exe|Microsoft\.DiaSymReader\.Native\..*\.dll)$'))" />
      <ResolvedFileToPublish Remove="@(_DebuggerFile)" />
    </ItemGroup>
  </Target>
</Project>
